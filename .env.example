# Copy to .env (git-ignored) and replace every value. Docker Compose reads .env
# from the project directory automatically for ${...} interpolation.
# Generate values with: openssl rand -hex 24
# Use hex or other URL-safe characters: POSTGRES_PASSWORD is placed inside
# DATABASE_URL, where characters such as @ : / # would break the URL.

POSTGRES_PASSWORD=change-me
CLAN_SECRET=change-me

# Optional
# CLAN_NAME=Urdnot
# LOG_LEVEL=info
# REVISION=   # set to `git rev-parse --short HEAD` to label the image
